{
  "require": {
    "php": ">=8.1",
    "stripe/stripe-php": "^20.1",
    "vlucas/phpdotenv": "^5.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "cd public && php -S 0.0.0.0:4242",
    "test": "phpunit --coverage-text"
  }
}
